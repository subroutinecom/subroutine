{
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.10.5",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^0.18.4",
    "@pothos/core": "npm:@pothos/core@^4.10.0",
    "@subroutinecom/config": "../packages/config/mod.ts",
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@^2.0.41",
    "@ai-sdk/google-vertex": "npm:@ai-sdk/google-vertex@^3.0.58",
    "@ai-sdk/openai": "npm:@ai-sdk/openai@^2.0.64",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.21.0",
    "ai": "npm:ai@^5.0.89",
    "bcrypt": "npm:bcrypt@^6.0.0",
    "better-auth": "npm:better-auth@1.3.31",
    "google-auth-library": "npm:google-auth-library@^10.5.0",
    "graphql": "npm:graphql@^16.12.0",
    "graphql-yoga": "npm:graphql-yoga@^5.16.2",
    "hono": "npm:hono@^4.10.4",
    "kysely": "npm:kysely@^0.28.8",
    "kysely-codegen": "npm:kysely-codegen@^0.19.0",
    "nanoid": "npm:nanoid@^5.1.6",
    "pg": "npm:pg@^8.16.3",
    "yaml": "npm:yaml@^2.8.1",
    "zod": "npm:zod@^3.25.76"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "DOM", "DOM.Iterable", "ES2022"],
    "types": ["npm:@types/node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "tasks": {
    "migrations:generate": "deno run --allow-read --allow-write scripts/generate-migrations-index.ts",
    "build": "deno task migrations:generate && deno compile --allow-net --allow-read --allow-env --allow-ffi --sloppy-imports --output api-server server.ts",
    "start": "deno run --env-file=.env --allow-net --allow-read --allow-env --allow-ffi --sloppy-imports --node-modules-dir server.ts",
    "typecheck": "deno check --sloppy-imports",
    "auth:generate": "deno run --allow-read --allow-write --allow-run --allow-env scripts/better-auth-generate.ts",
    "db:flush": "deno run --allow-read --allow-env --allow-net scripts/flush-db.ts",
    "graphql:schema": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys --sloppy-imports npm:@graphql-codegen/cli@6.0.2/graphql-codegen --config ./codegen.ts"
  },
  "lint": {
    "exclude": ["ecosystem.config.js"]
  }
}
