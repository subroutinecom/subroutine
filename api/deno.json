{
  "imports": {
    "@ai-sdk/google": "npm:@ai-sdk/google@^2.0.44",
    "@ai-sdk/mcp": "npm:@ai-sdk/mcp@^0.0.12",
    "@apidevtools/swagger-parser": "npm:@apidevtools/swagger-parser@^10.1.1",
    "@eslint/js": "npm:@eslint/js@^9.39.1",
    "@graphql-codegen/schema-ast": "npm:@graphql-codegen/schema-ast@^5.0.0",
    "@hono-rate-limiter/hono-rate-limiter": "jsr:@hono-rate-limiter/hono-rate-limiter@^0.4.2",
    "@hono/hono": "jsr:@hono/hono@^4.10.5",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^0.18.4",
    "@pothos/core": "npm:@pothos/core@^4.10.0",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "@subroutine/integration-types": "../packages/integration-types/mod.ts",
    "@subroutinecom/config": "../packages/config/mod.ts",
    "ajv": "npm:ajv@^8.17.1",
    "globals": "npm:globals@^16.5.0",
    "googleapis": "npm:googleapis@^134.0.0",
    "json-schema-to-ts": "npm:json-schema-to-ts@^3.1.1",
    "json-schema-to-zod": "npm:json-schema-to-zod@^2.7.0",
    "openapi-types": "npm:openapi-types@^12.1.3",
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@^2.0.41",
    "@ai-sdk/google-vertex": "npm:@ai-sdk/google-vertex@^3.0.85",
    "@ai-sdk/openai": "npm:@ai-sdk/openai@^2.0.64",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.25.1",
    "ai": "npm:ai@^5.0.115",
    "bcrypt": "npm:bcrypt@^6.0.0",
    "better-auth": "npm:better-auth@1.3.34",
    "google-auth-library": "npm:google-auth-library@^10.5.0",
    "graphql": "npm:graphql@^16.12.0",
    "graphql-yoga": "npm:graphql-yoga@^5.16.2",
    "hono": "npm:hono@^4.10.4",
    "kysely": "npm:kysely@^0.28.8",
    "kysely-codegen": "npm:kysely-codegen@^0.19.0",
    "nanoid": "npm:nanoid@^5.1.6",
    "pg": "npm:pg@^8.16.3",
    "react": "npm:react@^18.3.1",
    "react-dom": "npm:react-dom@^18.3.1",
    "react-router-dom": "npm:react-router-dom@^6.28.0",
    "@types/react": "npm:@types/react@^18.3.12",
    "@types/react-dom": "npm:@types/react-dom@^18.3.1",
    "@typescript-eslint/utils": "npm:@typescript-eslint/utils@^8.46.3",
    "redis": "npm:redis@^5.10.0",
    "ts-json-schema-generator": "npm:ts-json-schema-generator@^2.4.0",
    "typescript": "npm:typescript@^5.9.3",
    "yaml": "npm:yaml@^2.8.1",
    "zod": "npm:zod@^3.25.76",
    "ts-morph": "npm:ts-morph@^26.0.0",
    "winston": "npm:winston@^3.13.0",
    "eslint": "npm:eslint@^9.39.1",
    "typescript-eslint": "npm:typescript-eslint@^8.46.3"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "DOM", "DOM.Iterable", "ES2022"],
    "types": ["npm:@types/node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "tasks": {
    "migrations:generate": "deno run --allow-read --allow-write --allow-env scripts/generate-migrations-index.ts",
    "start": "deno run --env-file=.env --allow-net --allow-read --allow-env --allow-ffi --allow-sys --sloppy-imports --node-modules-dir server.ts",
    "typecheck": "deno check --sloppy-imports",
    "eslint": "deno run --allow-read --allow-env --allow-sys --allow-run npm:eslint@^9.39.1",
    "eslint:fix": "deno run --allow-read --allow-env --allow-sys --allow-run npm:eslint@^9.39.1 --fix",
    "auth:generate": "deno run --allow-read --allow-write --allow-run --allow-env scripts/better-auth-generate.ts",
    "db:flush": "deno run --allow-read --allow-env --allow-net scripts/flush-db.ts",
    "graphql:schema": "bash scripts/wait-for-api.sh && npx --yes -p @graphql-codegen/cli@6.0.2 -p @graphql-codegen/schema-ast@5.0.0 graphql-codegen --config ./codegen.yml"
  },
  "lint": {
    "exclude": ["ecosystem.config.js"]
  }
}
