# ==============================================================================
# Database Configuration
# ==============================================================================
# PostgreSQL connection string
# Note: When running via docker-compose, this is set automatically
DATABASE_URL=postgresql://subroutine:subroutine@postgres:5432/subroutine

# ==============================================================================
# AI Model Provider Configuration
# ==============================================================================
# Note: MODEL_PROVIDER and MODEL_NAME are now configured in config.yaml at the repository root
# See config.yaml for AI model provider and model selection

# Anthropic (Direct) Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Vertex AI Configuration
# Used for both vertex-anthropic and vertex-gemini providers
GOOGLE_VERTEX_PROJECT=your_gcp_project_id
GOOGLE_VERTEX_LOCATION=us-east5

# Google Vertex AI Authentication
# Two methods are supported:
# 1. Workload Federation (default): If these are not set, workload federation will be used
# 2. Service Account: Set these to use service account credentials
# To use service account authentication, provide the following env vars:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----

# ==============================================================================
# Better Auth Configuration
# ==============================================================================
# Note: Base URL and OAuth client IDs are configured in config.yaml (not secret)
# Only secrets should be in this file

# Better Auth Secret (required)
# Used for encryption, session signing, and generating hashes
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_generated_secret_here

# Encryption Key for Integrations (required)
# Used for encrypting OAuth credentials and tokens in the database
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_generated_encryption_key_here

# OAuth Provider Secrets
# Only required if the corresponding provider is enabled in config.yaml
#
# GitHub OAuth Setup:
# 1. Go to https://github.com/settings/developers
# 2. Create a new OAuth App
# 3. Add Client ID to config.yaml under auth.providers.github.clientId
# 4. Add Client Secret below (keep this secret!)
# 5. Set Authorization callback URL to: http://localhost:3002/api/auth/callback/github
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google OAuth Setup:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Client ID to config.yaml under auth.providers.google.clientId
# 4. Add Client Secret below (keep this secret!)
# 5. Add authorized redirect URI: http://localhost:3002/api/auth/callback/google
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
