# Model Provider Configuration
# Set MODEL_PROVIDER to explicitly choose a provider:
# - anthropic: Use Anthropic API directly
# - openai: Use OpenAI API
# - vertex-anthropic: Use Anthropic models through Google Vertex AI
# - vertex-gemini: Use Gemini models through Google Vertex AI
# If not set, provider will be auto-detected based on available credentials
MODEL_PROVIDER=anthropic

#	Model name configuration
MODEL_NAME=claude-sonnet-4-5-20250929
# MODEL_NAME=gpt-5

# Anthropic (Direct) Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Vertex AI Configuration
# Used for both vertex-anthropic and vertex-gemini providers
GOOGLE_VERTEX_PROJECT=your_gcp_project_id
GOOGLE_VERTEX_LOCATION=us-east5

# Google Vertex AI Authentication
# Two methods are supported:
# 1. Workload Federation (default): If these are not set, workload federation will be used
# 2. Service Account: Set these to use service account credentials
# To use service account authentication, provide the following env vars:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----
