{
  "workspace": ["./api", "./sandbox", "./tests", "./admin-panel", "./packages/integration-types"],
  "exclude": ["admin-panel/build"],
  "nodeModulesDir": "auto",
  "unstable": ["sloppy-imports"],
  "tasks": {
    "check": "deno check --sloppy-imports",
    "lint": "deno lint --sloppy-imports",
    "eslint": "deno run -A --sloppy-imports npm:eslint@9",
    "eslint:fix": "deno run -A --sloppy-imports npm:eslint@9 --fix",
    "prettier:check": "deno run -A npm:prettier@3 --check .",
    "prettier:format": "deno run -A npm:prettier@3 --write .",
    "test": "./run-tests.sh",
    "validate": "deno task check && deno task lint && deno task eslint"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "imports": {
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@^2.0.56",
    "@apidevtools/swagger-parser": "npm:@apidevtools/swagger-parser@^12.1.0",
    "@hono-rate-limiter/hono-rate-limiter": "jsr:@hono-rate-limiter/hono-rate-limiter@^0.4.2",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@eslint/js": "npm:@eslint/js@^9.39.2",
    "@types/node": "npm:@types/node@^24.10.4",
    "@typescript-eslint/utils": "npm:@typescript-eslint/utils@^8.50.0",
    "@graphql-codegen/cli": "npm:@graphql-codegen/cli@^6.1.0",
    "ai": "npm:ai@^5.0.115",
    "debug": "npm:debug@^4.4.3",
    "eslint": "npm:eslint@^9.39.2",
    "globals": "npm:globals@^16.5.0",
    "graphql": "npm:graphql@^16.12.0",
    "graphql-request": "npm:graphql-request@^7.4.0",
    "lru-cache": "npm:lru-cache@^11.2.4",
    "openapi-types": "npm:openapi-types@^12.1.3",
    "prettier": "npm:prettier@^3.7.4",
    "redis": "npm:redis@^5.10.0",
    "theme-change": "npm:theme-change@^2.5.0",
    "typescript-eslint": "npm:typescript-eslint@^8.50.0",
    "vite": "npm:vite@^7.3.0",
    "ts-morph": "npm:ts-morph@^26.0.0",
    "winston": "npm:winston@^3.19.0"
  },
  "lint": {
    "rules": {
      "exclude": ["no-sloppy-imports", "no-explicit-any", "no-slow-types", "require-await"]
    }
  }
}
