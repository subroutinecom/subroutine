{
  "workspace": ["./api", "./sandbox", "./tests", "./admin-panel"],
  "exclude": ["admin-panel/build"],
  "nodeModulesDir": "auto",
  "unstable": ["sloppy-imports"],
  "tasks": {
    "check": "deno check --sloppy-imports",
    "lint": "deno lint --sloppy-imports",
    "eslint": "deno run -A --sloppy-imports npm:eslint@9",
    "prettier:check": "deno run -A npm:prettier@3 --check .",
    "prettier:format": "deno run -A npm:prettier@3 --write .",
    "test": "docker compose exec tests deno test tests --allow-net --allow-env --allow-read --sloppy-imports --unstable-worker-options",
    "validate": "deno task check && deno task lint && deno task eslint && deno task prettier:check"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "imports": {
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@^2.0.49",
    "@hono-rate-limiter/hono-rate-limiter": "jsr:@hono-rate-limiter/hono-rate-limiter@^0.4.2",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@eslint/js": "npm:@eslint/js@^9.39.1",
    "@types/node": "npm:@types/node@^24.2.0",
    "@typescript-eslint/utils": "npm:@typescript-eslint/utils@^8.46.3",
    "@graphql-codegen/cli": "npm:@graphql-codegen/cli@^6.0.2",
    "ai": "npm:ai@^5.0.102",
    "debug": "npm:debug@^4.4.3",
    "eslint": "npm:eslint@^9.39.1",
    "globals": "npm:globals@^16.5.0",
    "graphql": "npm:graphql@^16.12.0",
    "graphql-request": "npm:graphql-request@^7.3.3",
    "prettier": "npm:prettier@^3.6.2",
    "theme-change": "npm:theme-change@^2.5.0",
    "typescript-eslint": "npm:typescript-eslint@^8.46.3",
    "vite": "npm:vite@^7.2.0",
    "ts-morph": "npm:ts-morph@^26.0.0"
  },
  "lint": {
    "rules": {
      "exclude": ["no-sloppy-imports", "no-explicit-any", "no-slow-types", "require-await"]
    }
  }
}
