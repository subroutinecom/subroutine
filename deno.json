{
  "workspace": ["./api", "./sandbox", "./tests", "./admin-panel"],
  "exclude": ["admin-panel/build"],
  "nodeModulesDir": "manual",
  "unstable": ["sloppy-imports", "bare-node-builtins"],
  "tasks": {
    "check": "deno check --sloppy-imports",
    "eslint": "deno run -A --sloppy-imports npm:eslint@9"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-sloppy-imports",
        "no-explicit-any",
        "no-slow-types",
        "require-await"
      ]
    }
  }
}
