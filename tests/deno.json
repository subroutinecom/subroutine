{
  "imports": {
    "@playwright/test": "npm:@playwright/test@^1.56.1",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/testing": "jsr:@std/testing@^1.0.16"
  },
  "tasks": {
    "test": "deno test --allow-net",
    "test:ui": "deno run --allow-all npm:@playwright/test@1.56.1 test tests/ui",
    "test:all": "deno test --allow-net tests && deno run --allow-all npm:@playwright/test@1.56.1 test tests/ui"
  }
}