{
  "imports": {
    "@graphql-codegen/cli": "npm:@graphql-codegen/cli@^6.0.2",
    "@graphql-codegen/typed-document-node": "npm:@graphql-codegen/typed-document-node@^6.1.2",
    "@graphql-codegen/typescript": "npm:@graphql-codegen/typescript@^5.0.4",
    "@graphql-codegen/typescript-operations": "npm:@graphql-codegen/typescript-operations@^5.0.4",
    "@graphql-typed-document-node/core": "npm:@graphql-typed-document-node/core@^3.2.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "better-auth": "npm:better-auth@^1.3.34",
    "fetch-cookie": "npm:fetch-cookie@^3.1.0",
    "graphql-request": "npm:graphql-request@^7.3.3",
