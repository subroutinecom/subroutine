{
  "imports": {
    "react": "npm:react@^18.3.1",
    "react-dom": "npm:react-dom@^18.3.1",
    "react-dom/client": "npm:react-dom@^18.3.1/client",
    "react-dom/server": "npm:react-dom@^18.3.1/server",
    "react-router": "npm:react-router@^7.1.1",
    "react-router-dom": "npm:react-router-dom@^7.1.1",
    "react-router-dom/server": "npm:react-router-dom@^7.1.1/server",
    "@types/react": "npm:@types/react@^18.3.18",
    "@types/react-dom": "npm:@types/react-dom@^18.3.5"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "lib": ["dom", "dom.iterable", "esnext"]
  },
  "tasks": {
    "lint": "npx eslint",
    "check": "deno check server.tsx",
    "dev": "deno run -A npm:@react-router/dev dev",
    "build": "deno run -A npm:@react-router/dev build",
    "start": "deno run -A npm:@react-router/serve ./build/server/index.js"
  }
}
