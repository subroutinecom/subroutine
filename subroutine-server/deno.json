{
  "exclude": [".react-router/", ".vite/"],
  "imports": {
    "@react-router/node": "npm:@react-router/node@^7.9.2",
    "@react-router/serve": "npm:@react-router/serve@^7.9.2",
    "isbot": "npm:isbot@^5.1.31",
    "react": "npm:react@^19.1.1",
    "react-dom": "npm:react-dom@^19.1.1",
    "react-router": "npm:react-router@^7.9.2",
    "@react-router/dev": "npm:@react-router/dev@^7.9.2",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.13",
    "@types/react": "npm:@types/react@^19.1.13",
    "@types/react-dom": "npm:@types/react-dom@^19.1.9",
    "tailwindcss": "npm:tailwindcss@^4.1.13",
    "typescript": "npm:typescript@^5.9.2",
    "vite": "npm:vite@^7.1.7",
    "vite-tsconfig-paths": "npm:vite-tsconfig-paths@^5.1.4",
    "arg": "npm:arg@^5",
    "~/": "./app/"
  },
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["npm:vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "tasks": {
    "build": "deno run --allow-all --node-modules-dir npm:@react-router/dev/react-router build",
    "dev": "deno run --allow-all --node-modules-dir npm:@react-router/dev/react-router dev",
    "start": "deno run --allow-all --node-modules-dir npm:@react-router/serve ./build/server/index.js",
    "typecheck": "deno check --sloppy-imports"
  }
}
